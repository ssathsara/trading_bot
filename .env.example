# =====================================================================
# AI Spot Trading Agent - environment configuration
# Copy to .env and fill in values. NEVER commit .env.
# This release supports SIMULATION ONLY: local paper trading and
# Binance Spot TESTNET. There is no live-trading mode.
# =====================================================================

# --- Application -------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# --- Auth (REQUIRED - startup fails closed without them) --------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
# At least 10 characters
ADMIN_PASSWORD=change-me-please
ADMIN_EMAIL=admin@example.com

# --- Database ------------------------------------------------------------
# Docker Compose overrides this to point at the postgres service.
# For a quick local run without Docker you can use SQLite:
#   DATABASE_URL=sqlite:///./data/trading.db
DATABASE_URL=postgresql+psycopg://trader:trader_password@localhost:5432/trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_password
POSTGRES_DB=trading

# --- Redis (optional; enables API <-> worker event broadcasting) ---------
# Leave empty to run the worker inside the API process instead.
REDIS_URL=
# true = run the trading worker inside the API process (single-process mode)
RUN_WORKER_IN_API=true

# --- Trading mode ----------------------------------------------------------
# PAPER (default) or TESTNET. LIVE is NOT supported and is rejected.
EXECUTION_MODE=PAPER
INITIAL_BALANCE_USDT=10000

# --- Binance public market data (read-only endpoints, no keys) -----------
# data-api.binance.vision / data-stream.binance.vision serve market data
# ONLY - they cannot accept orders.
MARKET_DATA_REST_URL=https://data-api.binance.vision
MARKET_DATA_WS_URL=wss://data-stream.binance.vision

# --- Binance Spot TESTNET (https://testnet.binance.vision/) --------------
# Use dedicated TESTNET credentials. Production keys will not work here.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_REST_URL=https://testnet.binance.vision
BINANCE_TESTNET_WS_URL=wss://stream.testnet.binance.vision
